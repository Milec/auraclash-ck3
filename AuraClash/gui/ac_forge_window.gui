					fittype = centercrop
					alpha = 0.6
				}
				background = { using = Background_Frame }
				widget = {
					size = { 100% 100% }
					alwaystransparent = yes
					datamodel = "[GetPlayer.MakeScope.Var('ac_forge_board').GetList('lines')]"
					item = { ac_forge_line = {} }
				}
				widget = {
					size = { 100% 100% }
					alwaystransparent = yes
					datamodel = "[GetPlayer.MakeScope.Var('ac_forge_board').GetList('nodes')]"
					item = { ac_forge_node = {} }
				}
			}
