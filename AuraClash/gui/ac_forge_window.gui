}

types AcForgeTypes
{
	type ac_forge_node = widget
	{
		allow_outside = yes
		state = { name = _mouse_hierarchy_enter on_start = "[GetScriptedGui('ac_forge_hover_enter').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]" }
		state = { name = _mouse_hierarchy_leave on_start = "[GetScriptedGui('ac_forge_hover_leave').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]" }
		button_standard = {
			size = { 96 34 }
			position = "[Subtract_CVector2f( FloatToCVector2f( FixedPointToFloat(Scope.Var('coord_x').GetValue), FixedPointToFloat(Scope.Var('coord_y').GetValue) ), '(CVector2f)48,17' )]"
			text = "[Localize(Concatenate('ac_forge_node_', Scope.Var('ac_forge_node').GetFlagKey))]"
			default_format = "#high"
			down = "[GetScriptedGui('ac_forge_node').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
			enabled = "[And(Not(Scope.Var('ac_forge_used').IsSet), GetScriptedGui('ac_forge_node').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
			onclick = "[GetScriptedGui('ac_forge_node').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
			tooltip = "[GetScriptedGui('ac_forge_node').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
		}
	}
	type ac_forge_line = widget
	{
		alpha = "[Scope.Var('opacity').GetValue]"
		size = { 100% 100% }
		line = {
			using = Line_Lifestyles_Unlocked
			width = 5
			from = "[FloatToCVector2f( FixedPointToFloat(Scope.Var('start_node').Var('coord_x').GetValue), FixedPointToFloat(Scope.Var('start_node').Var('coord_y').GetValue) )]"
			to = "[FloatToCVector2f( FixedPointToFloat(Scope.Var('end_node').Var('coord_x').GetValue), FixedPointToFloat(Scope.Var('end_node').Var('coord_y').GetValue) )]"
		}
	}
}
